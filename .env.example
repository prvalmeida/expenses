# Runtime configuration. Copy to `.env.local` for local dev, or inject these
# as secrets in your cloud platform (Cloud Run / ECS / Fly / etc.).
# Never commit real values — this file holds placeholders only.

MONGODB_URI=mongodb://user:password@host:27017/expenses?authSource=admin
OPENAI_API_KEY=sk-...
PDF_KEY=00000000000

# Static credential for the public API (`/api/v1/*`). The guard fails closed:
# when unset, every v1 route answers 401, so the UI keeps working while the
# public API stays shut. Generate one with `openssl rand -hex 32`.
API_KEY=

# To run the `prod` profile against the bundled compose MongoDB, use:
# MONGODB_URI=mongodb://admin:password@mongodb:27017/expenses?authSource=admin
# (host `mongodb` resolves only inside the compose network; match the
# MONGO_USER / MONGO_PASSWORD set in the root `.env` described below).

# ---------------------------------------------------------------------------
# The two variables below do NOT belong in `.env.local`. Compose interpolates
# `${MONGO_USER}` / `${MONGO_PASSWORD}` in docker-compose.yml from the host
# environment or a root `.env` file only — values in `.env.local` are ignored
# and the bundled MongoDB would silently initialize as admin / password.
# Put them in a root `.env` (also covered by .gitignore) to override:
#
#   MONGO_USER=admin
#   MONGO_PASSWORD=password
