# Runtime configuration. Copy to `.env.local` for local dev, or inject these
# as secrets in your cloud platform (Cloud Run / ECS / Fly / etc.).
# Never commit real values — this file holds placeholders only.

MONGODB_URI=mongodb://user:password@host:27017/expenses?authSource=admin
OPENAI_API_KEY=sk-...
PDF_KEY=00000000000

# Optional: local docker-compose MongoDB credentials (defaults: admin / password)
MONGO_USER=admin
MONGO_PASSWORD=password
