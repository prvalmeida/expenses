meta {
  name: Create an income
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/incomes
  body: json
  auth: none
}

body:json {
  {
    "name": "BRUNO_TEST_salario",
    "value": 4200.5,
    "type": "{{incomeType}}",
    "date": "2026-03-05"
  }
}

vars:post-response {
  incomeId: res.body.data._id
}

assert {
  res.status: eq 201
  res.body.data.value: eq 4200.5
}
