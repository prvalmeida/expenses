meta {
  name: Parse an NF-e PDF
  type: http
  seq: 1
  tags: [
    external
  ]
}

post {
  url: {{baseUrl}}/receipts/parse
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(fixtures/sample-receipt.pdf)
}

assert {
  res.status: eq 200
}

tests {
  test("items were extracted and classified", function () {
    expect(res.body.data.items.length).to.be.above(0);
  });
}

docs {
  Excluded from the default run (tag: external): every call hits OpenAI, and a
  real NF-e is personal financial data. Supply fixtures/sample-receipt.pdf
  yourself.
}
