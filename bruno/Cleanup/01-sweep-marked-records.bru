meta {
  name: Sweep BRUNO_TEST_ leftovers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/expenses?limit=500
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  // The collection writes to whatever baseUrl points at, and during development
  // that is the real database holding real personal finances. A run that aborts
  // mid-chain leaves orphan expenses in the Dashboard totals; the BRUNO_TEST_
  // prefix is what makes that debris identifiable instead of hand-picked out of
  // the table.
  //
  // Needs `--sandbox developer` for axios.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");

  // bru.getProcessEnv, not process.env: the sandbox does not expose the loaded
  // .env as a real process.env, so reading it directly sends an undefined key
  // and every sweep call comes back 401.
  const headers = { "x-api-key": bru.getProcessEnv("API_KEY") };

  const MAX_PAGES = 500;

  // Every page, not just the first. The list is sorted by date descending, so
  // with a few hundred real expenses the test debris — dated in the past —
  // lands on a later page and a first-page-only sweep silently leaves it behind.
  async function collectMarked(resource, firstPage) {
    const marked = [];
    let page = firstPage;

    for (let i = 0; i < MAX_PAGES; i++) {
      marked.push(...page.items.filter(record => record.name.startsWith("BRUNO_TEST_")));
      if (!page.nextCursor) return marked;

      const url = `${baseUrl}/${resource}?limit=500&cursor=${page.nextCursor}`;
      page = (await axios.get(url, { headers })).data.data;
    }

    throw new Error(`Sweep of ${resource} exceeded ${MAX_PAGES} pages — refusing to loop.`);
  }

  async function deleteAll(resource, records) {
    for (const record of records) {
      await axios.delete(`${baseUrl}/${resource}/${record._id}`, { headers });
    }
  }

  const expenses = await collectMarked("expenses", res.body.data);
  const incomes = await collectMarked(
    "incomes",
    (await axios.get(`${baseUrl}/incomes?limit=500`, { headers })).data.data
  );

  await deleteAll("expenses", expenses);
  await deleteAll("incomes", incomes);

  bru.setVar("sweptExpenses", expenses.length);
  bru.setVar("sweptIncomes", incomes.length);
  console.log(`Cleanup: removidos ${expenses.length} gastos e ${incomes.length} receitas marcados.`);
}
