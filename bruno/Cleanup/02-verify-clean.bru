meta {
  name: Verify no leftovers remain
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/expenses?limit=500
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  // Walks every page for the same reason the sweep does: checking only the
  // first page reports "clean" while debris dated in the past sits further
  // down the list, which is worse than not checking at all.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const headers = { "x-api-key": bru.getProcessEnv("API_KEY") };

  async function findMarked(resource, firstPage) {
    const marked = [];
    let page = firstPage;

    for (let i = 0; i < 500; i++) {
      marked.push(...page.items.filter(record => record.name.startsWith("BRUNO_TEST_")));
      if (!page.nextCursor) return marked;
      page = (await axios.get(`${baseUrl}/${resource}?limit=500&cursor=${page.nextCursor}`, { headers })).data.data;
    }

    throw new Error(`Scan of ${resource} exceeded 500 pages — refusing to loop.`);
  }

  bru.setVar("leftoverExpenses", (await findMarked("expenses", res.body.data)).map(e => e._id));
  bru.setVar(
    "leftoverIncomes",
    (await findMarked("incomes", (await axios.get(`${baseUrl}/incomes?limit=500`, { headers })).data.data)).map(i => i._id)
  );
}

tests {
  test("no BRUNO_TEST_ expense survives the run", function () {
    expect(bru.getVar("leftoverExpenses")).to.eql([]);
  });

  test("no BRUNO_TEST_ income survives the run", function () {
    expect(bru.getVar("leftoverIncomes")).to.eql([]);
  });
}
