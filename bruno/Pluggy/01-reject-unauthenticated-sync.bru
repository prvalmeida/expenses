meta {
  name: Reject an unauthenticated sync
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pluggy/sync
  body: none
  auth: none
}

headers {
  x-api-key:
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
}

docs {
  This is the cron target (Easypanel, every 6h, over the internal Docker
  network) — worth a test precisely because a bad key here means the sync
  silently never runs rather than failing loudly. No account or credentials
  are needed: the guard runs before anything else.
}
