meta {
  name: Discover a valid category
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/categories?kind=expense
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  // Categories are user-editable at runtime, so the chain discovers one instead
  // of hardcoding a name that may have been renamed or deleted.
  const categories = res.body.data;
  // Prefers a category that has subtypes: the PUT-clears-subtype step needs one,
  // and any expense category serves the rest of the chain equally.
  const chosen = categories.find(c => c.subtypes.length > 0) ?? categories[0];
  bru.setVar("expenseType", chosen.name);
  bru.setVar("expenseSubtype", chosen.subtypes[0] ?? null);
}

tests {
  test("there is at least one expense category", function () {
    expect(res.body.data.length).to.be.above(0);
  });
}
