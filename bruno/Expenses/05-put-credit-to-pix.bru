meta {
  name: Switch a parcela from credit to pix
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/expenses/{{firstExpenseId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "BRUNO_TEST_notebook",
    "value": 1000,
    "type": "{{expenseType}}",
    "subtype": "{{expenseSubtype}}",
    "paymentType": "pix",
    "date": "2026-03-31",
    "effectiveDate": "2026-03-31"
  }
}

assert {
  res.status: eq 200
}

tests {
  // The $unset cascade: leaving these behind produces an OtherExpense that
  // still looks like a card purchase everywhere it is read. Only a round-trip
  // shows it, which is why this lives here and not in a unit test.
  test("cardBrand, installment and totalInstallments are removed", function () {
    expect(res.body.data.cardBrand).to.equal(undefined);
    expect(res.body.data.installment).to.equal(undefined);
    expect(res.body.data.totalInstallments).to.equal(undefined);
  });

  test("paymentType actually changed", function () {
    expect(res.body.data.paymentType).to.equal("pix");
  });
}
