meta {
  name: Omitting the subtype in a PUT clears it
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/expenses/{{firstExpenseId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "BRUNO_TEST_notebook_renamed",
    "value": 1000,
    "type": "{{expenseType}}",
    "paymentType": "pix",
    "date": "2026-09-01"
  }
}

assert {
  res.status: eq 200
}

tests {
  // PUT replaces the eight editable fields, so an omitted subtype is a clear.
  // Mongoose drops undefined keys from an update, so assigning one did nothing
  // and the stored subtype survived a type change — exactly the orphaned pair
  // the Dashboard flags with ⚠.
  test("the subtype was removed", function () {
    expect(res.body.data.subtype).to.equal(undefined);
  });
}
