# Copy to bruno/.env (gitignored). Bruno loads it automatically and exposes the
# values as process.env inside .bru files.
#
# Must match the API_KEY the server was started with. Committing the real value
# would put a credential to a live financial database into git history.
API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Only needed for Pluggy/06-sync-real-account.bru (tag: external). The Pluggy
# accountId of an already-registered, enabled PluggyAccount to sync against.
# Committing a real one would expose which bank account is linked.
PLUGGY_TEST_ACCOUNT_ID=
