meta {
  name: Reject Telegram text with no API key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/telegram/expenses
  body: json
  auth: none
}

headers {
  x-api-key:
}

body:json {
  {
    "text": "nome: almoço\nvalor: 42,90\ncategoria: comida\nsubcategoria: Restaurante\npagamento: pix"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
}
