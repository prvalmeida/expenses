meta {
  name: Dry-run parses without persisting anything
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/telegram/expenses
  body: json
  auth: none
}

body:json {
  {
    "text": "nome: BRUNO_TEST_dryrun_telegram\nvalor: 42,90\ncategoria: comida\nsubcategoria: Restaurante\npagamento: pix",
    "dryRun": true
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // dryRun is only trustworthy if it is proven not to persist: parse the same
  // expense for real afterwards and confirm the collection holds zero records
  // with the dry-run name. Needs `--sandbox developer` for axios, and
  // bru.getProcessEnv (not process.env) because the sandbox does not expose
  // the loaded .env as a real process.env.
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const headers = { "x-api-key": bru.getProcessEnv("API_KEY") };

  test("the parsed expense echoes back", function () {
    expect(res.body.data.expense.name).to.equal("BRUNO_TEST_dryrun_telegram");
    expect(res.body.data.expense.value).to.equal(42.90);
    expect(res.body.data.expense.type).to.equal("comida");
    expect(res.body.data.expense.subtype).to.equal("Restaurante");
  });

  test("nothing was persisted", async function () {
    const resp = await axios.get(baseUrl + "/expenses?limit=500", { headers });
    const marked = resp.data.data.items.filter(
      (e) => e.name && e.name.startsWith("BRUNO_TEST_dryrun_telegram")
    );
    expect(marked.length).to.equal(0);
  });
}
